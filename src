			end)

			Slider["35"].MouseLeave:Connect(function()
				Slider.Hover = false

				if not dragging then
					Slider["38"].BackgroundColor3 = Color3.fromRGB(83, 83, 83)
				end
			end)

			Slider["35"].InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					dragging = true
					slide(input)
					PlayAudio("Click")
				end
			end)

			Slider["35"].InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					dragging = false
					if Slider.Hover then
