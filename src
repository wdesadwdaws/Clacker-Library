				-- StarterGui.IpadUI.Main.TabContent.TabHolder.Toggle.Toggled.UIStroke
				Toggle["4d"] = Instance.new("UIStroke", Toggle["4c"]);
				Toggle["4d"]["Transparency"] = 0.3;
				Toggle["4d"]["Thickness"] = 3;
				Toggle["4d"]["Color"] = Color3.fromRGB(83, 83, 83);
				Toggle["4d"]["ApplyStrokeMode"] = Enum.ApplyStrokeMode.Border;


				-- StarterGui.IpadUI.Main.TabContent.TabHolder.Toggle.Toggled.UICorner
				Toggle["4e"] = Instance.new("UICorner", Toggle["4c"]);



				-- StarterGui.IpadUI.Main.TabContent.TabHolder.Toggle.Toggled.Icon
				Toggle["4f"] = Instance.new("ImageLabel", Toggle["4c"]);
				Toggle["4f"]["BorderSizePixel"] = 0;
				Toggle["4f"]["BackgroundColor3"] = Color3.fromRGB(255, 255, 255);
				Toggle["4f"]["ImageTransparency"] = 1;
				Toggle["4f"]["AnchorPoint"] = Vector2.new(0.5, 0.5);
				Toggle["4f"]["Image"] = [[rbxassetid://10709790644]];
				Toggle["4f"]["Size"] = UDim2.new(1, 0, 1, 0);
				Toggle["4f"]["BorderColor3"] = Color3.fromRGB(0, 0, 0);
				Toggle["4f"]["BackgroundTransparency"] = 1;
				Toggle["4f"]["Name"] = [[Icon]];
				Toggle["4f"]["Position"] = UDim2.new(0.5, 0, 0.5, 0);

			end
			
			local function SetToggle(state)
				Toggle.State = state

				if state then
					Toggle["49"].Color = Color3.fromRGB(255,255,255)
					Toggle["4c"].BackgroundColor3 = Color3.fromRGB(98, 169, 90)
					Toggle["4d"].Color = Color3.fromRGB(0, 255, 0)
					Toggle["4a"].TextColor3 = Color3.fromRGB(255, 255, 255)
					Toggle["4f"].ImageTransparency = 0
				else
					Toggle["49"].Color = Color3.fromRGB(83,83,83)
					Toggle["4c"].BackgroundColor3 = Color3.fromRGB(25,25,25)
					Toggle["4d"].Color = Color3.fromRGB(83,83,83)
					Toggle["4a"].TextColor3 = Color3.fromRGB(147, 147, 147)
					Toggle["4f"].ImageTransparency = 1
				end

				options.Callback(state)
			end
			
			Toggle["47"].MouseEnter:Connect(function()
				Toggle.Hover = true
				
				if Toggle.Hover then
					Toggle["49"].Color = Color3.fromRGB(120, 120, 120)
					PlayAudio("Hover")
				end
			end)

			Toggle["47"].MouseLeave:Connect(function()
				Toggle.Hover = false

				if Toggle.State then
					Toggle["49"].Color = Color3.fromRGB(255,255,255)
				else
					Toggle["49"].Color = Color3.fromRGB(83,83,83)
				end
			end)

			uis.InputBegan:Connect(function(input, gpe)
				if gpe then return end

				if input.UserInputType == Enum.UserInputType.MouseButton1 and Toggle.Hover then
					SetToggle(not Toggle.State)

					PlayAudio("Click")
				end
			end)
			
			return Toggle
		end

		if GUI.CurrentTab == nil then
			Tab.ActivateTab()
		end
		return Tab
	end
	return GUI
end

function Library.ToggleUI(frame)
	if not frame then return end

	frame.Visible = not frame.Visible
end

return Library


