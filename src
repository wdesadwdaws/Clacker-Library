			local function updateSlider(percent)
				percent = math.clamp(percent, 0, 1)

				Slider["38"].Size = UDim2.new(percent, 0, 1, 0)

				local range = options.Max - options.Min
				local rawValue = options.Min + range * percent
				local value = math.floor(rawValue / options.Rounding + 0.5) * options.Rounding

				options.Value = value
				Slider["33"].Text = tostring(value)

				pcall(function()
					options.Callback(value)
				end)
			end

			local function slide(input)
				local mouseX = input.Position.X
				local sliderPos = Slider["35"].AbsolutePosition.X
				local sliderWidth = Slider["35"].AbsoluteSize.X

				local percent = (mouseX - sliderPos) / sliderWidth
				updateSlider(percent)
			end

